-- Hàm lấy CFrame hiện tại của nhân vật
local function getCharacterCFrame()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("HumanoidRootPart") then
        return character.HumanoidRootPart.CFrame
    end
    return CFrame.new()
end

-- Hàm Bật/Tắt chế độ ẩn mình dưới đất (Phím Z)
local function toggleUnderground()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart

    isUnderground = not isUnderground

    if isUnderground then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        hrp.CFrame = hrp.CFrame * CFrame.new(0, undergroundOffset, 0)
    else
        hrp.CFrame = hrp.CFrame * CFrame.new(0, -undergroundOffset, 0)
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

-- Vòng lặp duy trì Noclip liên tục khi ẩn dưới đất
game:GetService("RunService").Stepped:Connect(function()
    if isUnderground then
        local character = LocalPlayer.Character
        if character then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end
end)

-- Hàm quản lý tạo / xóa Bệ đứng (Phím X)
local function togglePlatform()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local hrp = character.HumanoidRootPart

    if isPlatformActive then
        isPlatformActive = false
        if createdPlatform then
            createdPlatform:Destroy()
            createdPlatform = nil
        end
    else
        isPlatformActive = true
        
        local platform = Instance.new("Part")
        platform.Name = "CustomPlayerPlatform"
        platform.Size = Vector3.new(6, 1, 6)
        platform.Anchored = true
        platform.CanCollide = true
        platform.Material = Enum.Material.SmoothPlastic
        platform.Transparency = 0.3
        platform.Color = Color3.fromRGB(0, 170, 255)
        
        local platformCFrame = hrp.CFrame * CFrame.new(0, 3.5, 0)
        platform.CFrame = platformCFrame
        platform.Parent = workspace
        
        createdPlatform = platform
        hrp.CFrame = platformCFrame * CFrame.new(0, 2, 0)
    end
end

-- Lắng nghe phím bấm (1, 2, 3, 4, X, Z)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    -- Phím Z: Ẩn dưới đất / Trở lại mặt đất
    if input.KeyCode == Enum.KeyCode.Z then
        toggleUnderground()
    end

    -- Phím X: Bật / Tắt Bệ đứng
    if input.KeyCode == Enum.KeyCode.X then
        togglePlatform()
    end

    -- Phím 1: StarFire
    if input.KeyCode == Enum.KeyCode.One then
        if Remote then
            local currentCFrame = getCharacterCFrame()
            pcall(function()
                Remote:InvokeServer("TryCast", "StarFire", {starFirePattern}, currentCFrame)
            end)
        end
    end

    -- Phím 2: Bật / Tắt tự động Spam Meteo (Bấm 1 lần để Bật, bấm lại 1 lần để Tắt)
    if input.KeyCode == Enum.KeyCode.Two then
        isSpammingMeteo = not isSpammingMeteo
        
        if isSpammingMeteo then
            task.spawn(function()
                while isSpammingMeteo do
                    if Remote then
                        local currentCFrame = getCharacterCFrame()
                        pcall(function()
                            Remote:InvokeServer("TryCast", "Meteo", {meteoPattern}, currentCFrame)
                        end)
                    end
                    task.wait(meteoDelay)
                end
            end)
        end
    end

    -- Phím 3: PrimeIceSwordV2
    if input.KeyCode == Enum.KeyCode.Three then
        if Remote then
            local currentCFrame = getCharacterCFrame()
            pcall(function()
                Remote:InvokeServer("TryCast", "PrimeIceSwordV2", {primeIceSwordV2Pattern}, currentCFrame)
            end)
        end
    end

    -- Phím 4: FireSword
    if input.KeyCode == Enum.KeyCode.Four then
        if Remote then
            local currentCFrame = getCharacterCFrame()
            pcall(function()
                Remote:InvokeServer("TryCast", "FireSword", {fireSwordPattern}, currentCFrame)
            end)
        end
    end
end)
