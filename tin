local function getCharacterCFrame()
	local character = LocalPlayer.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		return character.HumanoidRootPart.CFrame
	end
	return CFrame.new()
end

local function castStarFire()
	if Remote then
		pcall(function()
			Remote:InvokeServer("TryCast", "StarFire", {starFirePattern}, getCharacterCFrame())
		end)
	end
end

local function startMeteoSpam()
	if isSpammingMeteo then return end
	isSpammingMeteo = true
	task.spawn(function()
		while isSpammingMeteo do
			if Remote then
				pcall(function()
					Remote:InvokeServer("TryCast", "Meteo", {meteoPattern}, getCharacterCFrame())
				end)
			end
			task.wait(meteoDelay)
		end
	end)
end

local function stopMeteoSpam()
	isSpammingMeteo = false
end

local function castIceSword()
	if Remote then
		pcall(function()
			Remote:InvokeServer("TryCast", "IceSword", {iceSwordPattern}, getCharacterCFrame())
		end)
	end
end

-- UI Mobile
local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local screenGui = playerGui:FindFirstChild("SkillButtonsGui") or Instance.new("ScreenGui")
screenGui.Name = "SkillButtonsGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 180, 0, 60)
frame.Position = UDim2.new(0.5, -90, 0.8, 0)
frame.BackgroundTransparency = 1
frame.Parent = screenGui

local function createButton(name, text, position)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Text = text
	btn.Size = UDim2.new(0, 50, 0, 50)
	btn.Position = position
	btn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 20
	btn.Font = Enum.Font.SourceSansBold
	btn.Parent = frame

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = btn

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Thickness = 2
	stroke.Parent = btn

	return btn
end

local btn1 = createButton("Btn1", "1", UDim2.new(0, 0, 0, 0))
local btn2 = createButton("Btn2", "2", UDim2.new(0, 65, 0, 0))
local btn3 = createButton("Btn3", "3", UDim2.new(0, 130, 0, 0))

btn1.MouseButton1Click:Connect(castStarFire)
btn2.MouseButton1Down:Connect(startMeteoSpam)
btn2.MouseButton1Up:Connect(stopMeteoSpam)
btn3.MouseButton1Click:Connect(castIceSword)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.One then castStarFire() end
	if input.KeyCode == Enum.KeyCode.Two then startMeteoSpam() end
	if input.KeyCode == Enum.KeyCode.Three then castIceSword() end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Two then stopMeteoSpam() end
end)
 
